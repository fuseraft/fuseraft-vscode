{
  "name": "fuseraft",
  "displayName": "fuseraft",
  "description": "Chat with fuseraft agents in an interactive REPL panel, right in VS Code",
  "version": "0.2.0",
  "publisher": "fuseraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuseraft/fuseraft-vscode"
  },
  "homepage": "https://fuseraft.ai/fuseraft-cli/",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "repl",
    "chat",
    "fuseraft"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fuseraft.repl",
        "title": "Open REPL",
        "category": "fuseraft",
        "icon": "$(terminal)"
      },
      {
        "command": "fuseraft.replResume",
        "title": "Resume Chat",
        "category": "fuseraft",
        "icon": "$(history)"
      },
      {
        "command": "fuseraft.replNew",
        "title": "New Chat",
        "category": "fuseraft",
        "icon": "$(add)"
      },
      {
        "command": "fuseraft.replRename",
        "title": "Rename Chat",
        "category": "fuseraft",
        "icon": "$(edit)"
      },
      {
        "command": "fuseraft.replDelete",
        "title": "Delete Chat",
        "category": "fuseraft",
        "icon": "$(trash)"
      },
      {
        "command": "fuseraft.refreshChats",
        "title": "Refresh Chats",
        "category": "fuseraft",
        "icon": "$(refresh)"
      },
      {
        "command": "fuseraft.refreshMemory",
        "title": "Refresh Memory",
        "category": "fuseraft",
        "icon": "$(refresh)"
      },
      {
        "command": "fuseraft.memoryDelete",
        "title": "Delete Memory",
        "category": "fuseraft",
        "icon": "$(trash)"
      },
      {
        "command": "fuseraft.memoryDeleteAll",
        "title": "Delete All Memories",
        "category": "fuseraft",
        "icon": "$(clear-all)"
      },
      {
        "command": "fuseraft.refreshSkills",
        "title": "Refresh Skills",
        "category": "fuseraft",
        "icon": "$(refresh)"
      },
      {
        "command": "fuseraft.skillsAdd",
        "title": "Add Skill",
        "category": "fuseraft",
        "icon": "$(add)"
      },
      {
        "command": "fuseraft.skillsRemove",
        "title": "Remove Skill",
        "category": "fuseraft",
        "icon": "$(trash)"
      },
      {
        "command": "fuseraft.install",
        "title": "Install CLI",
        "category": "fuseraft",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fuseraft.update",
        "title": "Update CLI",
        "category": "fuseraft",
        "icon": "$(sync)"
      },
      {
        "command": "fuseraft.setup",
        "title": "Configure fuseraft",
        "category": "fuseraft",
        "icon": "$(account)"
      },
      {
        "command": "fuseraft.setBinaryPath",
        "title": "Set Binary Path",
        "category": "fuseraft",
        "icon": "$(file-binary)"
      },
      {
        "command": "fuseraft.setHomeDir",
        "title": "Set Home Directory",
        "category": "fuseraft",
        "icon": "$(folder)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fuseraft",
          "title": "fuseraft",
          "icon": "media/fuseraft.svg"
        }
      ]
    },
    "views": {
      "fuseraft": [
        {
          "id": "fuseraft.chats",
          "name": "Chats",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "fuseraft.memory",
          "name": "Memory",
          "icon": "$(lightbulb)",
          "initiallyCollapsed": true
        },
        {
          "id": "fuseraft.skills",
          "name": "Skills",
          "icon": "$(tools)",
          "initiallyCollapsed": true
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fuseraft.chats",
        "contents": "No chats in this workspace yet.\n\n[New Chat](command:fuseraft.replNew)\n\nEach chat is saved as you go, so you can pick it back up here later."
      },
      {
        "view": "fuseraft.memory",
        "contents": "No memories stored yet.\n\nMemories are saved automatically during REPL sessions and persist across sessions in ~/.fuseraft/memory/repl."
      },
      {
        "view": "fuseraft.skills",
        "contents": "No skills installed.\n\n[Add Skill](command:fuseraft.skillsAdd)\n\nSkills are reusable instructions agents can load on demand during a session."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fuseraft.replNew",
          "when": "view == fuseraft.chats",
          "group": "navigation@1"
        },
        {
          "command": "fuseraft.refreshChats",
          "when": "view == fuseraft.chats",
          "group": "navigation@2"
        },
        {
          "command": "fuseraft.update",
          "when": "view == fuseraft.chats",
          "group": "overflow@1"
        },
        {
          "command": "fuseraft.setup",
          "when": "view == fuseraft.chats",
          "group": "overflow@2"
        },
        {
          "command": "fuseraft.refreshMemory",
          "when": "view == fuseraft.memory",
          "group": "navigation"
        },
        {
          "command": "fuseraft.skillsAdd",
          "when": "view == fuseraft.skills",
          "group": "navigation"
        },
        {
          "command": "fuseraft.refreshSkills",
          "when": "view == fuseraft.skills",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fuseraft.replResume",
          "when": "view == fuseraft.chats && viewItem == replSession",
          "group": "inline@1"
        },
        {
          "command": "fuseraft.replDelete",
          "when": "view == fuseraft.chats && viewItem == replSession",
          "group": "inline@2"
        },
        {
          "command": "fuseraft.replResume",
          "when": "view == fuseraft.chats && viewItem == replSession",
          "group": "1_chat"
        },
        {
          "command": "fuseraft.replRename",
          "when": "view == fuseraft.chats && viewItem == replSession",
          "group": "1_chat@2"
        },
        {
          "command": "fuseraft.replDelete",
          "when": "view == fuseraft.chats && viewItem == replSession",
          "group": "2_danger"
        },
        {
          "command": "fuseraft.memoryDelete",
          "when": "view == fuseraft.memory && viewItem == memoryItem",
          "group": "inline"
        },
        {
          "command": "fuseraft.memoryDelete",
          "when": "view == fuseraft.memory && viewItem == memoryItem",
          "group": "1_memory"
        },
        {
          "command": "fuseraft.skillsRemove",
          "when": "view == fuseraft.skills && viewItem == skillItem",
          "group": "inline"
        },
        {
          "command": "fuseraft.skillsRemove",
          "when": "view == fuseraft.skills && viewItem == skillItem",
          "group": "1_skill"
        }
      ],
      "commandPalette": [
        {
          "command": "fuseraft.replDelete",
          "when": "false"
        },
        {
          "command": "fuseraft.replRename",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fuseraft.replRename",
        "key": "f2",
        "when": "focusedView == fuseraft.chats"
      }
    ],
    "configuration": {
      "title": "fuseraft",
      "properties": {
        "fuseraft.binaryPath": {
          "type": "string",
          "default": "fuseraft",
          "description": "Path to the fuseraft binary. Defaults to 'fuseraft' (must be on PATH). Set to an absolute path if needed."
        },
        "fuseraft.homeDir": {
          "type": "string",
          "default": "",
          "description": "Override the fuseraft home directory (default: ~/.fuseraft). Matches the CLI's FUSERAFT_HOME environment variable — useful when the OS home directory isn't durable (roaming/ephemeral profiles, RDS/VDI). Leave blank to use the default, or an already-set FUSERAFT_HOME environment variable."
        },
        "fuseraft.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a reply finishes, or an approval or question is waiting, while you're away from the REPL panel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
